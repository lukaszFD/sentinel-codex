# ============================================================
# Sentinel Codex — .env (rendered by playbook 04 [04.1.4])
# ============================================================
# Read by docker-compose-sentinel-codex.yml only.
# Single quotes: docker compose keeps the value literal ($ in werkzeug
# hashes is not interpolated). A ' inside a UI password is emitted as
# \u0027 so it cannot close the quote — still valid JSON for the app.
# ============================================================

# Module news — config page
NEWS_UI_DB_USER={{ news_editor_db_user }}
NEWS_UI_DB_PASSWORD='{{ vault_news_editor_db_password }}'
NEWS_UI_SECRET_KEY='{{ vault_news_ui_secret_key }}'
NEWS_UI_USERS='{{ vault_news_ui_users | to_json | replace("'", "\\u0027") }}'
